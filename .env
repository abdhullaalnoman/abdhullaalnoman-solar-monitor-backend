PORT=3200
TIMEZONE=Asia/Dhaka

# PostgreSQL / TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solar_monitor
DB_USER=postgres
DB_PASSWORD=58658532

# Solar WebSocket feed (sends lines like  solar1:12,10,12,32,4.2,1,1,gra,70 )
SOLAR_WS_URL=ws://27.147.170.162:81
SOLAR_CACHE_REFRESH_MS=60000

# A site is "online" if we heard from it within this many seconds
ONLINE_WINDOW_SECONDS=300
# When adding up energy, never count a gap longer than this between two readings
# (protects the totals if the feed was down for a while)
MAX_GAP_SECONDS=300
